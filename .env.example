# OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DETECTOR_MODEL=

# Optional detector-specific overrides
# DETECTOR_API_KEY=
# DETECTOR_BASE_URL=

# Pipeline paths and workload
